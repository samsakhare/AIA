generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TriggerType {
  AUTOMATIC
  DTMF
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  USER
}

enum CallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Tenant {
  id                 String      @id @default(uuid())
  name               String
  handoffTriggerType TriggerType @default(AUTOMATIC)
  dtmfTriggerKey     String?
  twilioPhoneNumber  String?
  forwardingNumber   String?
  createdAt          DateTime    @default(now())
  users              User[]
  calls              Call[]
}

model User {
  id          String         @id @default(uuid())
  name        String?
  email       String         @unique
  password    String
  phoneNumber String?
  role        Role           @default(USER)
  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  twilioNumbers TwilioNumber[]
  calls         Call[]
}

model TwilioNumber {
  id           String   @id @default(uuid())
  sid          String   @unique
  phoneNumber  String   @unique
  locality     String?
  capabilities Json
  status       String   @default("ACTIVE")
  twilioData   Json
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  calls        Call[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Call {
  id             String       @id @default(uuid())
  tenantId       String?
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  twilioNumberId String?
  twilioNumber   TwilioNumber? @relation(fields: [twilioNumberId], references: [id], onDelete: SetNull)
  from           String?
  to             String?
  status         String
  totalDuration  Int?         // in seconds
  totalCost      Float?
  recordingUrl   String?
  transcript     Json?
  extractedData  Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  legs           CallLeg[]
}

model CallLeg {
  id        String   @id @default(uuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  callSid   String   @unique
  direction String?
  from      String?
  to        String?
  status    String?
  duration  Int?
  cost      Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
