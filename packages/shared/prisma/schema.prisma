generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TriggerType {
  AUTOMATIC
  DTMF
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  USER
}

enum CallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Tenant {
  id                 String      @id @default(uuid())
  name               String
  handoffTriggerType TriggerType @default(AUTOMATIC)
  dtmfTriggerKey     String?
  twilioPhoneNumber  String?
  forwardingNumber   String?
  createdAt          DateTime    @default(now())
  users              User[]
  calls              Call[]
}

model User {
  id          String         @id @default(uuid())
  name        String?
  email       String         @unique
  password    String
  phoneNumber String?
  role        Role           @default(USER)
  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  twilioNumbers TwilioNumber[]
}

model TwilioNumber {
  id           String   @id @default(uuid())
  sid          String   @unique
  phoneNumber  String   @unique
  locality     String?
  capabilities Json
  status       String   @default("ACTIVE")
  twilioData   Json
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Call {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerNumber String
  status         CallStatus
  recordingUrl   String?
  transcript     Json?
  extractedData  Json?
  createdAt      DateTime   @default(now())
}
