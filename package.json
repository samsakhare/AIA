{
  "name": "saas-poc",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev:infra": "docker compose up -d postgres redis",
    "dev": "npm run dev:infra && turbo run dev",
    "format": "prettier --write .",
    "lint": "turbo run lint",
    "check-all": "npm run format && npm run lint"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "latest",
    "typescript": "latest"
  }
}
